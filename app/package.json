{
  "name": "catraca-app",
  "version": "0.1.0",
  "private": true,
  "description": "Aplicação da Catraca: venda de ingressos para eventos pequenos.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "gates": "node tools/gates.mjs",
    "migrate": "node dist/cli/index.js migrate",
    "seed": "node dist/cli/index.js seed",
    "cli": "node dist/cli/index.js"
  },
  "dependencies": {
    "@fastify/formbody": "^8.0.2",
    "fastify": "^5.12.8",
    "fastify-plugin": "^5.1.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.4",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
